{
  "name": "@examples/multi-platform-mobile",
  "type": "module",
  "private": true,
  "main": "./src/index.tsx",
  "scripts": {
    "dev": "pnpm generate:boot && expo start",
    "ios": "pnpm generate:boot && expo start --ios",
    "android": "pnpm generate:boot && expo start --android",
    "build": "pnpm generate:boot && expo export --platform ios --platform android --output-dir dist",
    "generate:boot": "node --import jiti/register scripts/generate-boot.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@examples/multi-platform-favorites-feature": "workspace:*",
    "@examples/multi-platform-native-storage": "workspace:*",
    "@examples/multi-platform-product-shell": "workspace:*",
    "@examples/multi-platform-shared": "workspace:*",
    "@react-cordis/boot": "workspace:*",
    "@react-cordis/renderer": "workspace:*",
    "expo": "~57.0.20",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "tamagui": "2.7.7"
  },
  "devDependencies": {
    "@react-cordis/boot-config": "workspace:*",
    "@react-cordis/vite": "workspace:*",
    "@react-native/metro-config": "0.86.3",
    "jiti": "^2.6.1"
  }
}
