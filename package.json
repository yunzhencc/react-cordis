{
  "name": "@yunzhen/cordis-starter-react",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": "^22.18.0 || ^24.12.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "pnpm --filter @examples/agent build",
    "build:gallery": "pnpm --filter @examples/gallery build",
    "start": "pnpm --filter @examples/agent dev",
    "start:basic": "pnpm --filter @examples/basic dev",
    "start:gallery": "pnpm --filter @examples/gallery dev",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json && pnpm -r exec tsc --noEmit",
    "prepare": "simple-git-hooks",
    "preinstall": "npx only-allow pnpm"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@eslint-react/eslint-plugin": "^5.18.6",
    "@examples/app-layout": "workspace:*",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@yunzhen/tsconfig": "^1.0.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.4.1",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "simple-git-hooks": {
    "commit-msg": "npx --no -- commitlint --edit $1",
    "pre-commit": "npx lint-staged",
    "preserveUnused": [
      "commit-msg"
    ]
  },
  "lint-staged": {
    "*": "eslint --fix"
  },
  "browserslist": [
    "defaults"
  ]
}
